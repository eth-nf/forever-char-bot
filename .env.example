# Copy this file to .env and fill it in. .env is ignored by git: never commit it.

# --- Discord: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Your server's ID (right-click the server -> Copy Server ID, with Developer Mode on).
# With it, slash commands appear in that server at once. Without it they are registered
# globally, which can take up to an hour.
DISCORD_GUILD_ID=

# --- Blizzard: https://develop.battle.net/access/clients -> Create Client
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# us, eu, kr or tw
BLIZZARD_REGION=us

# --- Your guild
# The guild's name exactly as in game. Used when /guild is run without a name, and to
# suggest character names while typing.
DEFAULT_GUILD=
# horde or alliance: whose auction houses /price checks by default.
DEFAULT_FACTION=horde

# --- Storage (optional)
# Folder where character claims are saved (data/claims.json by default).
DATA_DIR=

# --- Auction house (optional)
# Forever lists 15 auction houses and the API doesn't say which one serves whom yet.
# /price shows each house's ID. Compare a few prices in game, then list your house IDs here
# (comma-separated) so /price only shows those.
AH_HOUSE_IDS=
# How often to check Blizzard for new auction data. Blizzard updates it about hourly, and a
# check that finds nothing new is tiny, so a few minutes is fine.
AH_CHECK_MINUTES=5
# Load auction data when the bot starts, so the first /price is fast.
AH_WARMUP=true
# Any valid ruleset ID (1 PvP, 2 Normal, 3 Roleplay, 15 Roleplay PvP). The auction houses
# are currently the same under every ruleset.
RULESET_ID=15
